# Demo works without a database; online routes fail closed until configured.
NEXTSTEP_APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Choose only AFTER Tulane IT confirms the provider: saml or azure.
NEXTSTEP_SSO_MODE=
# For saml: provider UUID returned by your Supabase SSO configuration.
NEXTSTEP_SAML_PROVIDER_ID=
# Never put a service-role key, Tulane password, or IdP secret in browser code.
# Enter the IdP client secret/certificate directly in Supabase Auth settings.
